<% content_for :stylesheets do %>
  <%= stylesheet_link_tag "users_new", "data-turbo-track": "reload" %>
<% end %>

<h2 class="Title_text">予定の新規追加</h2>

<div class="Form">
<%= form_with model: @user do |f| %>
  <table>
    <tr>
      <th><%= f.label :title ,"タイトル" %></th>
      <td><%= f.text_field :title, class: "form-control" %></td>
    </tr>

    <tr>
      <th><%= f.label :start_date ,"開始日" %></th>
      <td><%= f.date_field :start_date, class: "form-control" %></td>
    </tr>

    <tr>
      <th><%= f.label :end_date ,"終了日" %></th>
      <td><%= f.date_field :end_date, class: "form-control" %><%= render "shared/error", obj: @user %></td>
    </tr>

    <tr>
      <th><%= f.label :all_day ,"終日" %></th>
      <td><%= f.check_box :all_day %></td>
    </tr>

    <tr>
      <th><%= f.label :memo ,"スケジュールメモ" %></th>
      <td><%= f.text_area :memo, class: "form-control" %></td>
    </tr>

  </table>

    <div class="btn">
      <%= link_to "キャンセル", :users, class: "btn btn-secondary" %>
      <%= f.submit "保存", class: "btn btn-primary" %>
    </div>
</div>

<% end %>
